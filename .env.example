# Leave blank to automatically select the correct API for each platform:
# Android emulator (Pixel 7): http://10.0.2.2:3001
# Web / iOS simulator: http://localhost:3001
EXPO_PUBLIC_API_URL=
# Physical phone: set EXPO_PUBLIC_API_URL to http://YOUR_COMPUTER_LAN_IP:3001
PORT=3001
DATABASE_PATH=server/data/app.db
# Comma separated web origins; native clients do not send Origin
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
