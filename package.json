{
  "name": "appgk",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "setup": "node scripts/setup.mjs",
    "android:clear": "expo start --android --clear",
    "test:rules": "node --test tests/firebase-rules.test.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/firestore-data.mjs import",
    "db:export": "node --env-file-if-exists=.env scripts/firestore-data.mjs export"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "react-dom": "19.1.0",
    "expo-status-bar": "~3.0.8",
    "firebase": "^12.0.0",
    "expo-image-picker": "~17.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
