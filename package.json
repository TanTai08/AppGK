{
  "name": "appgk",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "setup": "node scripts/setup.mjs",
    "android:clear": "expo start --android --clear",
    "iphone": "expo start --lan",
    "build:ios": "expo export --platform ios",
    "build:android": "expo export --platform android",
    "test:rules": "node --test tests/firebase-rules.test.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/firestore-data.mjs import",
    "db:export": "node --env-file-if-exists=.env scripts/firestore-data.mjs export"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4",
    "react-dom": "19.3.0",
    "expo-status-bar": "~58.0.5",
    "firebase": "^12.0.0",
    "expo-image-picker": "~58.0.10",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
